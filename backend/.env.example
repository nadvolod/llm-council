# Neon Postgres connection string (postgres:// or postgresql:// accepted)
DATABASE_URL=

# Clerk JWKS endpoint used to verify session JWT signatures
CLERK_JWKS_URL=

# Optional: Clerk issuer (e.g. https://your-app.clerk.accounts.dev). When set,
# the token's `iss` claim is verified against it.
CLERK_ISSUER=

# Clerk Backend API secret key (reads the user's OpenRouter key from privateMetadata)
CLERK_SECRET_KEY=

# Comma-separated list of allowed CORS origins (frontend domains)
CORS_ORIGINS=
